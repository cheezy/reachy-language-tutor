# Per-developer machine state. AGENTS.md defines agents.local.md as local session
# context (robot type, local paths, HF account). Shared setup knowledge belongs in
# docs/SETUP.md instead, so it is reviewed and versioned like everything else.
agents.local.md

# Secrets. Never commit these.
# Stride API token - grants full board access. Comments must be on their
# own line; .gitignore has no trailing-comment syntax.
.stride_auth.md

# Stride runtime state. Per-run hook artifacts, never versioned.
.stride/

# Exploratory-testing artifacts. They transcribe application output, which is exactly
# the material the redaction rules keep out of anything published.
.exploratory/
.stride-changed-files.json
.stride-diff-upload-state
.stride-dirty-baseline
.stride-env-cache
.env
.env.*
!.env.example
*.key
*.pem
*.crt
*.csr

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
build/
dist/
*.egg-info/
.eggs/

# Virtual environments
reachy_mini_env/
.venv/
venv/
ENV/
env/

# Test and lint caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
coverage.xml

# Editors and tooling
.vscode/
.idea/
# Local Claude state stays out, but skills are project knowledge and are versioned:
# a skill that vanishes on a fresh clone cannot reduce anything. (Git cannot re-include
# a path under an excluded DIRECTORY, hence the /* form rather than a bare .claude/.)
.claude/*
!.claude/skills/
*.swp
*.swo

# macOS
.DS_Store

# Logs and scratch
*.log
tmp/

# Learner database: per-installation runtime state holding personal data.
# WAL mode writes -wal and -shm sidecars that contain the same data.
*.sqlite3
*.sqlite3-wal
*.sqlite3-shm

# Face models are fetched from the hub at a pinned revision, never committed.
# The recognizer alone is 37 MB, and a model in the tree is a model nobody can
# tell apart from the pinned one it was supposed to be.
*.onnx
